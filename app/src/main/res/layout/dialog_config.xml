<?xml version="1.0" encoding="utf-8"?>
<!-- 配置弹窗（Finder 三栏式）：头部区（左=标题/Tab，中=扫码推送区常驻：二维码+地址+提示，右=关闭）
     + 配置|仓库|线路 三列联动列表 + 底部手动添加输入行（名称|链接|确定）。
     层级由三列横排表达（不再使用面包屑），TV 焦点左右键自然跨列移动 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_960"
    android:layout_height="@dimen/vs_480"
    android:background="@drawable/shape_danmu_setting_bg">

    <!-- 配置弹窗（Finder 三栏式）：头部区（左=标题/Tab，中=扫码推送区常驻：二维码+地址+提示，右=关闭）
         + 配置|仓库|线路 三列联动列表 + 底部手动添加输入行（名称|链接|确定）。
         层级由三列横排表达（不再使用面包屑），TV 焦点左右键自然跨列移动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 头部区：左=标题/提示/类别Tab；中=扫码推送区（二维码+地址+提示常驻）；右=关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/vs_30"
                android:text="配置"
                android:textColor="@color/atv_text_primary"
                android:textSize="@dimen/ts_26" />

            <TextView
                android:id="@+id/tvTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/vs_30"
                android:text=""
                android:textColor="@color/atv_text_secondary"
                android:textSize="@dimen/ts_20" />

            <!-- 类别 Tab：按当前链接实际含有的数据段显隐（sites=点播 / lives=直播 / dramas=短剧 / musics=音乐），
                 在哪个类别下选线路就只生效到对应模块 -->
            <LinearLayout
                android:id="@+id/llTypeTabs"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_40"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_30"
                android:paddingRight="@dimen/vs_30">

                <TextView
                    android:id="@+id/tabVod"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_setting_model_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:singleLine="true"
                    android:text="点播"
                    android:textColor="@color/nav_text_color"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/tabLive"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/shape_setting_model_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:singleLine="true"
                    android:text="直播"
                    android:textColor="@color/nav_text_color"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/tabDrama"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/shape_setting_model_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:singleLine="true"
                    android:text="短剧"
                    android:textColor="@color/nav_text_color"
                    android:textSize="@dimen/ts_22" />

                <TextView
                    android:id="@+id/tabMusic"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/shape_setting_model_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_15"
                    android:paddingRight="@dimen/vs_15"
                    android:singleLine="true"
                    android:text="音乐"
                    android:textColor="@color/nav_text_color"
                    android:textSize="@dimen/ts_22" />
            </LinearLayout>
        </LinearLayout>

        <!-- 扫码推送区（右上常驻）：二维码 + 访问地址 + 提示 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingRight="@dimen/vs_30">

            <FrameLayout
                android:id="@+id/flQRCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_qr_bg"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_5">

                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="@dimen/vs_80"
                    android:scaleType="fitXY" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_15"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手机扫码，远程推送配置"
                    android:textColor="@color/atv_text_secondary"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/tvPushUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_5"
                    android:maxWidth="@dimen/vs_280"
                    android:singleLine="true"
                    android:textColor="@color/atv_text_primary"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>
        </LinearLayout>

        <!-- 关闭按钮（最右） -->
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_50"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/vs_5"
            android:layout_marginRight="@dimen/vs_30"
            android:focusable="true"
            android:src="@drawable/icon_close" />
    </LinearLayout>

    <!-- 三列联动区：左=配置 / 中=仓库 / 右=线路，各列列头 + 竖向列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_20"
        android:paddingRight="@dimen/vs_20"
        android:paddingTop="@dimen/vs_5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_40"
                android:gravity="center"
                android:text="配置项名"
                android:textColor="@color/atv_text_secondary"
                android:textSize="@dimen/ts_20"
                android:textStyle="bold" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rvConfig"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingLeft="@dimen/vs_5"
                android:paddingRight="@dimen/vs_5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1.4"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_40"
                android:gravity="center"
                android:text="仓库名"
                android:textColor="@color/atv_text_secondary"
                android:textSize="@dimen/ts_20"
                android:textStyle="bold" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rvWarehouse"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingLeft="@dimen/vs_5"
                android:paddingRight="@dimen/vs_5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_40"
                android:gravity="center"
                android:text="线路名"
                android:textColor="@color/atv_text_secondary"
                android:textSize="@dimen/ts_20"
                android:textStyle="bold" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/rvLine"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingLeft="@dimen/vs_5"
                android:paddingRight="@dimen/vs_5" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30">

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="1"
            android:background="@drawable/input_dialog_api_input"
            android:hint="输入名字（可空）"
            android:paddingLeft="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/atv_text_primary"
            android:textColorHint="@color/atv_text_secondary"
            android:textSize="@dimen/ts_22" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="2.2"
            android:background="@drawable/input_dialog_api_input"
            android:hint="输入配置链接"
            android:paddingLeft="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/atv_text_primary"
            android:textColorHint="@color/atv_text_secondary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="@dimen/vs_90"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/button_dialog_main"
            android:focusable="true"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
    </LinearLayout>

    <!-- 扫码推送解析遮罩：推送开始时朦胧盖住整个弹窗转圈，完成后隐藏 -->
    <FrameLayout
        android:id="@+id/flPushLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="@dimen/vs_60"
                android:layout_height="@dimen/vs_60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_15"
                android:text="正在解析中，请耐心等候"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
