<?xml version="1.0" encoding="utf-8"?>
<!-- 配置弹窗：标题+面包屑/扫码推送/关闭，中部三级配置列表，底部手动添加输入行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_960"
    android:layout_height="@dimen/vs_480"
    android:background="@drawable/shape_danmu_setting_bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_50"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="配置"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_26" />

        <TextView
            android:id="@+id/tvBreadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_toRightOf="@id/tvTitle"
            android:gravity="center"
            android:textColor="@color/atv_text_secondary"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/btnScan"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@id/ivClose"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_20"
            android:paddingRight="@dimen/vs_20"
            android:text="扫码推送"
            android:textColor="@color/atv_text_secondary"
            android:textSize="@dimen/ts_22" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/vs_40"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:focusable="true"
            android:src="@drawable/icon_delete" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/vs_30"
        android:text=""
        android:textColor="@color/atv_text_secondary"
        android:textSize="@dimen/ts_20" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/rvConfig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30">

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/input_dialog_api_input"
            android:hint="输入名字（可空）"
            android:paddingLeft="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/atv_text_primary"
            android:textColorHint="@color/atv_text_secondary"
            android:textSize="@dimen/ts_22" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:layout_weight="2.2"
            android:background="@drawable/input_dialog_api_input"
            android:hint="输入配置链接"
            android:paddingLeft="@dimen/vs_10"
            android:singleLine="true"
            android:textColor="@color/atv_text_primary"
            android:textColorHint="@color/atv_text_secondary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="@dimen/vs_90"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/button_dialog_main"
            android:focusable="true"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_24" />
    </LinearLayout>
</LinearLayout>
