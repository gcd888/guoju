<?xml version="1.0" encoding="utf-8"?>
<!-- 多仓推送对话框：左=推送链接列表（可刷新重拉），右=当前链接下多仓接口列表；顶部保留扫码推送 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/vs_50"
    android:layout_marginTop="@dimen/vs_20"
    android:layout_marginRight="@dimen/vs_50"
    android:layout_marginBottom="@dimen/vs_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_20"
        android:paddingTop="@dimen/vs_15"
        android:paddingRight="@dimen/vs_20"
        android:paddingBottom="@dimen/vs_15">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="多仓配置"
                android:textColor="@color/atv_text_primary"
                android:textSize="@dimen/ts_28"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="@dimen/vs_35"
                android:layout_height="@dimen/vs_35"
                android:focusable="true"
                android:src="@drawable/icon_delete" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:orientation="horizontal">

            <!-- 左栏：推送链接列表 -->
            <LinearLayout
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="推送链接"
                    android:textColor="@color/atv_text_secondary"
                    android:textSize="@dimen/ts_22" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_6"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnAddSource"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_40"
                        android:background="@drawable/button_detail_sort"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="@dimen/vs_14"
                        android:paddingRight="@dimen/vs_14"
                        android:text="添加链接"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_20" />

                    <TextView
                        android:id="@+id/btnRefreshTree"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/vs_40"
                        android:layout_marginLeft="@dimen/vs_10"
                        android:background="@drawable/button_detail_sort"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingLeft="@dimen/vs_14"
                        android:paddingRight="@dimen/vs_14"
                        android:text="刷新资源树"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/ts_20" />
                </LinearLayout>

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/rvPushSources"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_280"
                    android:layout_marginTop="@dimen/vs_10"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_6"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_6" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/vs_1"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/vs_15"
                android:layout_marginRight="@dimen/vs_15"
                android:background="@color/atv_card_stroke" />

            <!-- 右栏：多仓接口列表 + 扫码推送 -->
            <LinearLayout
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWarehouseTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="接口列表（仓 > 接口 > 站源）"
                    android:textColor="@color/atv_text_secondary"
                    android:textSize="@dimen/ts_22" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/rvWarehouses"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_280"
                    android:layout_marginTop="@dimen/vs_10"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_6"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="@dimen/vs_6" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vs_10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivQRCode"
                        android:layout_width="@dimen/vs_80"
                        android:layout_height="@dimen/vs_80"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/vs_10"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="@color/atv_text_tertiary"
                        android:textSize="@dimen/ts_16" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
