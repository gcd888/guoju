<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 首页骨架：内容铺满全屏，导航/分类 tab 均为悬浮层（主页态 tab 叠在 Hero 底部） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atv_bg">

    <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
        android:id="@+id/mViewPager"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/atv_safe_side"
        android:paddingRight="@dimen/atv_safe_side"
        android:translationY="@dimen/atv_hero_h"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
        app:tv_selectedItemIsCentered="false" />

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/atv_nav_h"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/shape_top_nav_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/atv_safe_side"
        android:paddingRight="@dimen/atv_safe_side"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="@dimen/vs_35"
            android:layout_height="@dimen/vs_35"
            android:layout_marginRight="@dimen/vs_10"
            android:background="@drawable/shape_nav_text_focus"
            android:contentDescription="首页"
            android:focusable="true"
            android:padding="@dimen/vs_2"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_home" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:focusable="false"
            android:gravity="left|center_vertical"
            android:maxWidth="@dimen/vs_240"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textAlignment="gravity"
            android:textColor="@color/atv_text_secondary"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/navLive"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_nav_text_focus"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:text="直播"
            android:textColor="@color/nav_text_color"
            android:textSize="@dimen/ts_26" />

        <TextView
            android:id="@+id/navSearch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_nav_text_focus"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:text="搜索"
            android:textColor="@color/nav_text_color"
            android:textSize="@dimen/ts_26" />

        <TextView
            android:id="@+id/navPush"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_nav_text_focus"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:text="推送"
            android:textColor="@color/nav_text_color"
            android:textSize="@dimen/ts_26" />

        <TextView
            android:id="@+id/navSetting"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/vs_20"
            android:background="@drawable/shape_nav_text_focus"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:text="设置"
            android:textColor="@color/nav_text_color"
            android:textSize="@dimen/ts_26" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
