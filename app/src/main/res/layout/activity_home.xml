<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV 首页骨架：内容铺满全屏，导航/分类 tab 均为悬浮层（主页态 tab 叠在 Hero 底部） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atv_bg">

    <com.github.gcd888.guoju.ui.tv.widget.NoScrollViewPager
        android:id="@+id/mViewPager"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="@dimen/atv_safe_side"
        android:paddingRight="@dimen/atv_safe_side"
        android:translationY="@dimen/atv_hero_h"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
        app:tv_selectedItemIsCentered="false" />

    <!-- 顶部导航栏：共享布局 nav_top_bar.xml（短剧主页 DramaHomeFragment 同款 include），
         高度由代码按字号动态设置 -->
    <include
        layout="@layout/nav_top_bar"
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/atv_nav_h"
        android:layout_marginTop="@dimen/vs_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
