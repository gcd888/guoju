<?xml version="1.0" encoding="utf-8"?>
<!-- 多仓对话框左栏条目：推送链接（选中高亮）+ 删除 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_10"
    android:paddingRight="@dimen/vs_10"
    android:paddingTop="@dimen/vs_8"
    android:paddingBottom="@dimen/vs_8">

    <TextView
        android:id="@+id/tvSourceUrl"
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/atv_text_secondary"
        android:textSize="@dimen/ts_20" />

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="@dimen/vs_30"
        android:layout_height="@dimen/vs_30"
        android:layout_marginLeft="@dimen/vs_6"
        android:focusable="true"
        android:src="@drawable/icon_delete" />
</LinearLayout>
