<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <!-- 右上角关闭 X：默认聚焦，遥控器确认键直接关闭弹窗 -->
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:layout_gravity="end"
            android:focusable="true"
            android:src="@drawable/icon_close" />

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_240"
            android:layout_height="@dimen/vs_240"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_10" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="@dimen/vs_340"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_20"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:textAlignment="gravity"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24"
            tools:text="1111111111111111111111111111111111111111111111111111" />
    </LinearLayout>
</FrameLayout>
