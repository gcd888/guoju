<?xml version="1.0" encoding="utf-8"?>
<!-- Hero 轮播单页：大图 + 底部渐变遮罩 + 左下标题/副标题 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="afterDescendants"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivHero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingLeft="@dimen/atv_safe_side"
        android:paddingRight="@dimen/atv_safe_side">

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:maxLines="1"
            android:shadowColor="@color/atv_scrim_bottom"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/hero_title_color"
            android:textSize="@dimen/ts_26" />

        <TextView
            android:id="@+id/tvHeroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_6"
            android:alpha="0.85"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/atv_scrim_bottom"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_20" />

        <!-- 行数由代码动态计算（HeroInfoLayout：按底部 tab 行实际位置留 20mm）；
             宽度必须 wrap_content：代码里 setWidth(屏幕物理宽/2) 只对 wrap_content 生效 -->
        <TextView
            android:id="@+id/tvHeroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:alpha="0.75"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/atv_scrim_bottom"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>
</FrameLayout>
