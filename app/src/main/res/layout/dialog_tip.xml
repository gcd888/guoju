<?xml version="1.0" encoding="utf-8"?>
<!-- 通用确认弹窗：确认类按钮(id=rightBtn)视觉在左，取消(id=leftBtn)视觉在右。
     注意 id 与视觉位置相反（历史约定：调用方第一参数=取消、第二参数=确认动作），
     TipDialog 点击任一按钮后自动 dismiss。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_440"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_tip_dialog_bg"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">


        <TextView
            android:id="@+id/tipInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:lineSpacingExtra="@dimen/ts_50"
            android:lineSpacingMultiplier="0"
            android:textAlignment="gravity"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_24"
            tools:text="1111111111111111111111111111111111111111111111111111" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_30"
            android:orientation="horizontal">

            <!-- 视觉左侧：确认类按钮（调用方第二参数文案），蓝色实底与灰色取消一眼区分 -->
            <TextView
                android:id="@+id/rightBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_5"
                android:background="@drawable/shape_tip_btn_primary"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:paddingTop="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_10"
                android:text="确定"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />

            <!-- 视觉右侧：取消按钮（调用方第一参数文案），灰底描边 -->
            <TextView
                android:id="@+id/leftBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_5"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_20"
                android:paddingRight="@dimen/vs_20"
                android:paddingTop="@dimen/vs_10"
                android:paddingBottom="@dimen/vs_10"
                android:text="取消"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
