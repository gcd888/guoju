<?xml version="1.0" encoding="utf-8"?>
<!-- 多仓对话框右栏条目：仓名 + 配置链接 + 当前接口标记 + 删除 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_10"
    android:paddingRight="@dimen/vs_10"
    android:paddingTop="@dimen/vs_8"
    android:paddingBottom="@dimen/vs_8">

    <LinearLayout
        android:layout_width="@dimen/vs_0"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvWarehouseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/tvWarehouseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/atv_text_tertiary"
            android:textSize="@dimen/ts_16" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCurrentMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/vs_6"
        android:text="当前"
        android:textColor="@color/atv_accent"
        android:textSize="@dimen/ts_18"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivDelete"
        android:layout_width="@dimen/vs_30"
        android:layout_height="@dimen/vs_30"
        android:layout_marginLeft="@dimen/vs_6"
        android:focusable="true"
        android:src="@drawable/icon_delete" />
</LinearLayout>
