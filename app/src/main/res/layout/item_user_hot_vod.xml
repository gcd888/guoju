<?xml version="1.0" encoding="utf-8"?>
<!-- 推荐货架卡片：竖版海报 + 左上角标 + 底部备注 + 下方标题（Apple TV 风格） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/mItemFrame"
        android:layout_width="@dimen/atv_home_poster_w"
        android:layout_height="@dimen/atv_home_poster_h"
        android:background="@drawable/shape_poster_card_bg">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/vs_6"
            android:alpha="0.85"
            android:background="@color/atv_scrim_mid"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_6"
            android:paddingRight="@dimen/vs_6"
            android:paddingTop="@dimen/vs_2"
            android:paddingBottom="@dimen/vs_2"
            android:singleLine="true"
            android:textColor="@color/atv_text_primary"
            android:textSize="@dimen/ts_14" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginLeft="@dimen/vs_8"
            android:layout_marginRight="@dimen/vs_8"
            android:layout_marginBottom="@dimen/vs_8"
            android:ellipsize="end"
            android:gravity="left"
            android:shadowColor="@color/atv_scrim_bottom"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:singleLine="true"
            android:textColor="@color/atv_text_secondary"
            android:textSize="@dimen/ts_18"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_user_delete"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vs_20"
                android:src="@drawable/icon_delete" />
        </FrameLayout>
    </FrameLayout>

    <TextView
            android:id="@+id/tvName"
            android:layout_width="@dimen/atv_home_poster_w"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_6"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/atv_text_secondary"
        android:textSize="@dimen/ts_20" />
</LinearLayout>
